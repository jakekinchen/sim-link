{
  "schema_version": "scenesmith.pi05_autolearn.v1",
  "cycle_id": "cycle-001-mps",
  "train_seeds": [7200, 7201, 7202, 7203],
  "eval_seeds": [7300, 7301, 7302, 7303],
  "accepted_model": "outputs/robot_lab/so101_desk_cube_sort/models/pi05-scenesmith-so101-sort-lora-v10-red-balanced-250",
  "candidate_model": "outputs/robot_lab/autolearn/cycle-001-mps/train/checkpoints/000025/pretrained_model",
  "manifest_path": "experiments/pi05_autolearn/cycles/cycle-001-mps.json",
  "accepted_pointer_path": "experiments/pi05_autolearn/accepted.json",
  "baseline_evaluation": "outputs/robot_lab/autolearn/cycle-001-mps/baseline-eval/intervention_batch_summary.json",
  "candidate_evaluation": "outputs/robot_lab/autolearn/cycle-001-mps/candidate-eval/intervention_batch_summary.json",
  "stages": [
    {
      "name": "baseline_eval",
      "argv": [
        "./.mujoco_venv/bin/python",
        "scripts/robot_lab/run_pi05_eval_with_server.py",
        "--policy-repo", "{accepted_model}",
        "--output-dir", "outputs/robot_lab/autolearn/{cycle_id}/baseline-eval",
        "--seed", "{eval_seed_start}",
        "--episodes", "{eval_episodes}",
        "--device", "mps",
        "--policy-port", "8840",
        "--grasp-assist-mode", "policy_gripper",
        "--max-policy-steps", "6000"
      ],
      "timeout_s": 43200,
      "required_artifacts": [
        "outputs/robot_lab/autolearn/{cycle_id}/baseline-eval/intervention_batch_summary.json"
      ],
      "log_path": "outputs/robot_lab/autolearn/{cycle_id}/logs/baseline-eval.log"
    },
    {
      "name": "collect_dagger",
      "argv": [
        "./.mujoco_venv/bin/python",
        "scripts/robot_lab/run_pi05_eval_with_server.py",
        "--policy-repo", "{accepted_model}",
        "--output-dir", "outputs/robot_lab/autolearn/{cycle_id}/collection",
        "--seed", "{train_seed_start}",
        "--episodes", "{train_episodes}",
        "--device", "mps",
        "--policy-port", "8840",
        "--grasp-assist-mode", "policy_gripper_tray_transfer",
        "--max-policy-steps", "6000"
      ],
      "timeout_s": 43200,
      "required_artifacts": [
        "outputs/robot_lab/autolearn/{cycle_id}/collection/intervention_batch_summary.json"
      ],
      "log_path": "outputs/robot_lab/autolearn/{cycle_id}/logs/collect-dagger.log"
    },
    {
      "name": "export_corrections",
      "argv": [
        "external/leLab/.venv/bin/python",
        "scripts/robot_lab/export_intervention_dataset.py",
        "--batch-summary", "outputs/robot_lab/autolearn/{cycle_id}/collection/intervention_batch_summary.json",
        "--output-root", "outputs/robot_lab/autolearn/{cycle_id}/dagger-dataset",
        "--repo-id", "local/pi05-dagger-cycle-001-mps",
        "--fps", "30",
        "--frame-selection", "dagger_corrections",
        "--dataset-schema", "pi05_causal",
        "--verify"
      ],
      "timeout_s": 7200,
      "required_artifacts": [
        "outputs/robot_lab/autolearn/{cycle_id}/dagger-dataset/meta/info.json",
        "outputs/robot_lab/autolearn/{cycle_id}/dagger-dataset/scenesmith_pi05_dataset_contract.json",
        "outputs/robot_lab/autolearn/{cycle_id}/dagger-dataset/scenesmith_intervention_export_summary.json"
      ],
      "log_path": "outputs/robot_lab/autolearn/{cycle_id}/logs/export-corrections.log"
    },
    {
      "name": "aggregate_dataset",
      "argv": [
        "external/leLab/.venv/bin/python",
        "scripts/robot_lab/merge_pi05_training_datasets.py",
        "--base-root", "outputs/robot_lab/so101_desk_cube_sort/datasets/causal_pi05_tail_v2_stage_tasks/dataset",
        "--corrections-root", "outputs/robot_lab/autolearn/{cycle_id}/dagger-dataset",
        "--output-root", "outputs/robot_lab/autolearn/{cycle_id}/training-dataset",
        "--repo-id", "local/pi05-autolearn-cycle-001-mps",
        "--normalization-root", "outputs/robot_lab/so101_desk_cube_sort/datasets/causal_pi05_tail_v2_stage_tasks/dataset"
      ],
      "timeout_s": 7200,
      "required_artifacts": [
        "outputs/robot_lab/autolearn/{cycle_id}/training-dataset/meta/info.json",
        "outputs/robot_lab/autolearn/{cycle_id}/training-dataset/scenesmith_pi05_dataset_contract.json",
        "outputs/robot_lab/autolearn/{cycle_id}/training-dataset/scenesmith_merge_summary.json"
      ],
      "log_path": "outputs/robot_lab/autolearn/{cycle_id}/logs/aggregate-dataset.log"
    },
    {
      "name": "train",
      "argv": [
        "external/leLab/.venv/bin/python",
        "-m", "lerobot.scripts.lerobot_train",
        "--dataset.repo_id=local/pi05-autolearn-cycle-001-mps",
        "--dataset.root=outputs/robot_lab/autolearn/{cycle_id}/training-dataset",
        "--dataset.eval_split=0.0",
        "--dataset.return_uint8=true",
        "--policy.path={accepted_model}",
        "--policy.device=mps",
        "--policy.dtype=float32",
        "--policy.push_to_hub=false",
        "--policy.gradient_checkpointing=true",
        "--policy.compile_model=false",
        "--policy.optimizer_lr=5e-7",
        "--policy.scheduler_warmup_steps=5",
        "--policy.scheduler_decay_steps={max_steps}",
        "--rename_map={{\"observation.images.top\":\"observation.images.base_0_rgb\",\"observation.images.wrist\":\"observation.images.left_wrist_0_rgb\"}}",
        "--steps={max_steps}",
        "--batch_size=1",
        "--num_workers=0",
        "--log_freq=1",
        "--save_freq={max_steps}",
        "--save_checkpoint=true",
        "--env_eval_freq=0",
        "--eval_steps=0",
        "--wandb.enable=false",
        "--output_dir=outputs/robot_lab/autolearn/{cycle_id}/train"
      ],
      "timeout_s": 21600,
      "required_artifacts": [
        "{candidate_model}/train_config.json",
        "{candidate_model}/adapter_model.safetensors"
      ],
      "log_path": "outputs/robot_lab/autolearn/{cycle_id}/logs/train.log",
      "env": {
        "HF_HUB_OFFLINE": "1",
        "TRANSFORMERS_OFFLINE": "1",
        "PYTORCH_ENABLE_MPS_FALLBACK": "1",
        "TOKENIZERS_PARALLELISM": "false"
      }
    },
    {
      "name": "finalize_candidate",
      "argv": [
        "external/leLab/.venv/bin/python",
        "scripts/robot_lab/finalize_pi05_checkpoint.py",
        "--checkpoint-root", "{candidate_model}",
        "--source-config", "{accepted_model}/config.json",
        "--normalization-stats", "outputs/robot_lab/autolearn/{cycle_id}/training-dataset/meta/stats.json"
      ],
      "timeout_s": 60,
      "required_artifacts": [
        "{candidate_model}/config.json",
        "{candidate_model}/scenesmith_finalize_summary.json"
      ],
      "log_path": "outputs/robot_lab/autolearn/{cycle_id}/logs/finalize-candidate.log"
    },
    {
      "name": "candidate_eval",
      "argv": [
        "./.mujoco_venv/bin/python",
        "scripts/robot_lab/run_pi05_eval_with_server.py",
        "--policy-repo", "{candidate_model}",
        "--output-dir", "outputs/robot_lab/autolearn/{cycle_id}/candidate-eval",
        "--seed", "{eval_seed_start}",
        "--episodes", "{eval_episodes}",
        "--device", "mps",
        "--policy-port", "8840",
        "--grasp-assist-mode", "policy_gripper",
        "--max-policy-steps", "6000"
      ],
      "timeout_s": 43200,
      "required_artifacts": [
        "outputs/robot_lab/autolearn/{cycle_id}/candidate-eval/intervention_batch_summary.json"
      ],
      "log_path": "outputs/robot_lab/autolearn/{cycle_id}/logs/candidate-eval.log"
    }
  ],
  "training": {
    "stage": "train",
    "max_steps": 25
  },
  "git": {
    "auto_commit": true,
    "clean_paths": [
      "GOAL.md",
      "configurations/robot_lab",
      "docs/briefs",
      "docs/session-logs",
      "docs/reviewer-messages",
      "experiments/pi05_autolearn",
      "scenesmith/robot_lab/autolearn.py",
      "scenesmith/robot_lab/autolearn_cycle.py",
      "scenesmith/robot_lab/intervention_supervisor.py",
      "scenesmith/robot_lab/pi05_dataset_contract.py",
      "scenesmith/robot_lab/so101_coordinates.py",
      "scripts/robot_lab/export_intervention_dataset.py",
      "scripts/robot_lab/finalize_pi05_checkpoint.py",
      "scripts/robot_lab/generate_causal_pi05_dataset.py",
      "scripts/robot_lab/merge_pi05_training_datasets.py",
      "scripts/robot_lab/pi05_local_server.py",
      "scripts/robot_lab/relabel_causal_pi05_tasks.py",
      "scripts/robot_lab/run_pi05_autolearn_cycle.py",
      "scripts/robot_lab/run_pi05_eval_with_server.py",
      "scripts/robot_lab/stamp_pi05_dataset_contract.py",
      "tests/unit/test_pi05_autolearn.py"
    ]
  },
  "promotion": {
    "min_pure_success_rate": 0.75,
    "min_success_rate_delta": 0.0,
    "allow_contact_gated_grasp_assist": true
  }
}
